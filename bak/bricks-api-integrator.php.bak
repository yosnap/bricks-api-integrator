if (!defined('ABSPATH')) {
    exit; // Evita accesos directos
}

// Definir constantes del plugin
define('BRICKS_API_INTEGRATOR_VERSION', '1.0');
define('BRICKS_API_INTEGRATOR_PATH', plugin_dir_path(__FILE__));
define('BRICKS_API_INTEGRATOR_URL', plugin_dir_url(__FILE__));

// Incluir los archivos necesarios
require_once BRICKS_API_INTEGRATOR_PATH . 'dynamic-tags.php';
require_once BRICKS_API_INTEGRATOR_PATH . 'includes/endpoints.php';
require_once BRICKS_API_INTEGRATOR_PATH . 'includes/launcher.php';
require_once BRICKS_API_INTEGRATOR_PATH . 'includes/sources.php';
require_once BRICKS_API_INTEGRATOR_PATH . 'includes/templates.php';

// Cargar la clase de consulta después de que WordPress y los plugins estén cargados
function bricks_api_integrator_load_queries() {
    // Solo cargar si Bricks está activo
    if (!function_exists('bricks_is_builder') && !defined('BRICKS_VERSION')) {
        return;
    }
    
    // Cargar la clase de consulta
    require_once BRICKS_API_INTEGRATOR_PATH . 'includes/class-api-source-query.php';
}
add_action('init', 'bricks_api_integrator_load_queries', 5);

// Registrar los sources con el Query Loop de Bricks
function bricks_api_integrator_register_query_loop_sources() {
    // Obtener los sources de API configurados
    $api_sources = get_option('bricks_api_sources', []);
    
    // Registrar el tipo genérico de API Source
    add_filter('bricks/query/loop/types', function($types) {
        $types['api_source'] = [
            'name' => esc_html__('API Source', 'bricks-api-integrator'),
            'icon' => 'ti-cloud-down',
        ];
        
        // También registrar los tipos externos
        $types['clinicas_detalle'] = [
            'name' => esc_html__('Detalle de Clínica', 'bricks-api-integrator'),
            'icon' => 'ti-cloud-down',
        ];
        
        $types['clinicas_listado'] = [
            'name' => esc_html__('Listado de Clínicas', 'bricks-api-integrator'),
            'icon' => 'ti-cloud-down',
        ];
        
        return $types;
    });
    
    // Registrar cada source como un tipo de query
    foreach ($api_sources as $source_id => $source) {
        $source_name = isset($source['name']) ? $source['name'] : esc_html__('Unnamed Source', 'bricks-api-integrator');
        
        // Registrar el tipo de query
        add_filter('bricks/query/loop/types', function($types) use ($source_id, $source_name) {
            $types[$source_id] = [
                'name' => $source_name,
                'icon' => 'ti-cloud-down',
            ];
            return $types;
        });
    }
}
add_action('init', 'bricks_api_integrator_register_query_loop_sources', 30);

// Procesar las consultas de API
add_filter('bricks/query/run', function($results, $query_obj) {
    // Debug intensivo
    error_log('=== BRICKS API INTEGRATOR DEBUG ===');
    error_log('Query object recibido: ' . print_r($query_obj, true));
    
    // Obtener el tipo de query
    $query_type = isset($query_obj->object_type) ? $query_obj->object_type : '';
    error_log('Query type: ' . $query_type);
    
    // Obtener los sources de API configurados
    $api_sources = get_option('bricks_api_sources', []);
    
    // Verificar si el tipo de query corresponde a uno de nuestros sources
    $is_our_source = isset($api_sources[$query_type]);
    
    // Comprobar si es un tipo externo que queremos procesar (como clinicas_detalle)
    $external_types = ['clinicas_detalle', 'clinicas_listado']; // Añadir aquí otros tipos externos
    $is_external_type = in_array($query_type, $external_types);
    
    if (!$is_our_source && !$is_external_type) {
        error_log('No es nuestro query type - devolviendo results original');
        return $results;
    }
    
    // Si es un tipo externo, usar su configuración específica
    if ($is_external_type) {
        error_log('Procesando tipo externo: ' . $query_type);
        
        // Aquí puedes añadir lógica específica para cada tipo externo
        if ($query_type === 'clinicas_detalle') {
            // Verificar parámetros de diferentes formas
            $clinic_id = null;
            
            // Método 1: Buscar en settings del query
            if (isset($query_obj->settings) && isset($query_obj->settings['clinic_id'])) {
                $clinic_id = $query_obj->settings['clinic_id'];
                error_log('ID desde settings: ' . $clinic_id);
            }
            
            // Método 2: Buscar en dynamic_params del query
            if (!$clinic_id && isset($query_obj->settings) && isset($query_obj->settings['dynamic_params']) && is_array($query_obj->settings['dynamic_params'])) {
                foreach ($query_obj->settings['dynamic_params'] as $param) {
                    if (isset($param['param_name']) && $param['param_name'] === 'id' && isset($param['param_value'])) {
                        $clinic_id = $param['param_value'];
                        error_log('ID desde dynamic_params: ' . $clinic_id);
                        break;
                    }
                }
            }
            
            // Método 3: $_GET
            if (!$clinic_id && isset($_GET['id'])) {
                $clinic_id = sanitize_text_field($_GET['id']);
                error_log('ID desde $_GET: ' . $clinic_id);
            }
            
            // Método 4: get_query_var (para URLs amigables)
            if (!$clinic_id) {
                $clinic_id = get_query_var('id');
                error_log('ID desde get_query_var: ' . $clinic_id);
            }
            
            // Método 5: Extraer de URL manualmente
            if (!$clinic_id) {
                $request_uri = $_SERVER['REQUEST_URI'] ?? '';
                if (preg_match('#/detalle-clinica/(\d+)/?#', $request_uri, $matches)) {
                    $clinic_id = $matches[1];
                    error_log('ID desde URL regex: ' . $clinic_id);
                }
            }
            
            // Si aún no hay ID, usar un ID de prueba para desarrollo/vista previa
            if (!$clinic_id && (bricks_is_builder() || bricks_is_builder_call())) {
                $clinic_id = '1'; // ID de prueba para el builder
                error_log('Usando ID de prueba para builder: ' . $clinic_id);
            }
            
            if (!$clinic_id) {
                error_log('❌ NO SE ENCONTRÓ CLINIC_ID');
                // Devolver datos de muestra para que no falle completamente
                return [
                    'count' => 1,
                    'items' => [[
                        'id' => 0,
                        'nombre' => 'Ejemplo Clínica (ID no encontrado)',
                        'direccion' => 'Dirección de ejemplo',
                        'telefono' => '123456789',
                        'email' => 'ejemplo@clinica.com',
                        'descripcion' => 'Esta es una clínica de ejemplo porque no se encontró el ID.',
                        'servicios' => ['Servicio 1', 'Servicio 2'],
                        'horario' => 'Lunes a Viernes: 9:00 - 18:00',
                        'latitud' => 40.416775,
                        'longitud' => -3.703790
                    ]],
                    'max_num_pages' => 1,
                ];
            }
            
            error_log('✅ CLINIC_ID encontrado: ' . $clinic_id);
            
            // Hacer petición a la API
            $api_url = 'https://test-mys-acceso-clinicas-api.azurewebsites.net/api/clinicas/infoWebTest?id=' . $clinic_id;
            error_log('URL API: ' . $api_url);
            
            $response = wp_remote_get($api_url, [
                'timeout' => 30,
                'headers' => [
                    'User-Agent' => 'WordPress/Bricks'
                ]
            ]);
            
            if (is_wp_error($response)) {
                error_log('❌ Error en petición API: ' . $response->get_error_message());
                return $results;
            }
            
            $status_code = wp_remote_retrieve_response_code($response);
            error_log('Código HTTP: ' . $status_code);
            
            if ($status_code !== 200) {
                error_log('❌ HTTP Error: ' . $status_code);
                return $results;
            }
            
            $body = wp_remote_retrieve_body($response);
            $api_data = json_decode($body, true);
            
            if (json_last_error() !== JSON_ERROR_NONE) {
                error_log('❌ Error JSON: ' . json_last_error_msg());
                return $results;
            }
            
            error_log('✅ Datos obtenidos exitosamente');
            error_log('Datos: ' . print_r($api_data, true));
            
            // Si los datos no son un array, convertirlos en un array para que funcione el loop
            if (!is_array($api_data)) {
                $api_data = [$api_data];
            }
            
            // Asegurarse de que cada elemento tenga el ID para referencia
            foreach ($api_data as $key => $item) {
                if (!isset($item['id'])) {
                    $api_data[$key]['id'] = $clinic_id;
                }
            }
            
            return [
                'count' => count($api_data),
                'items' => $api_data,
                'max_num_pages' => 1,
            ];
        } else if ($query_type === 'clinicas_listado') {
            // Lógica para el listado de clínicas
            $api_url = 'https://test-mys-acceso-clinicas-api.azurewebsites.net/api/clinicas/infoListaWeb';
            error_log('URL API Listado: ' . $api_url);
            
            $response = wp_remote_get($api_url, ['timeout' => 30]);
            
            if (is_wp_error($response)) {
                error_log('❌ Error API Listado: ' . $response->get_error_message());
                return $results;
            }
            
            $body = wp_remote_retrieve_body($response);
            $api_data = json_decode($body, true);
            
            if (empty($api_data) || !is_array($api_data)) {
                error_log('❌ Error en datos de listado');
                return $results;
            }
            
            error_log('✅ Listado obtenido: ' . count($api_data) . ' clínicas');
            
            return [
                'count' => count($api_data),
                'items' => $api_data,
                'max_num_pages' => 1,
            ];
        }
    }
    
    error_log('=== PROCESANDO QUERY API SOURCE ===');
    error_log('Source detectado: ' . $query_type);
    
    try {
        // Obtener la configuración del source
        $source = $api_sources[$query_type];
        $endpoint_id = isset($source['endpoint_id']) ? $source['endpoint_id'] : '';
        
        // Obtener la configuración del endpoint
        $endpoints = get_option('bricks_api_endpoints', []);
        
        if (!isset($endpoints[$endpoint_id])) {
            error_log('Endpoint no encontrado: ' . $endpoint_id);
            return $results;
        }
        
        $endpoint = $endpoints[$endpoint_id];
        $endpoint_url = isset($endpoint['url']) ? $endpoint['url'] : '';
        
        if (empty($endpoint_url)) {
            error_log('URL de endpoint vacía');
            return $results;
        }
        
        error_log('URL API: ' . $endpoint_url);
        
        // Obtener los datos de la API
        $auth_type = isset($endpoint['auth_type']) ? $endpoint['auth_type'] : 'none';
        $token = isset($endpoint['token']) ? $endpoint['token'] : '';
        $basic_user = isset($endpoint['basic_user']) ? $endpoint['basic_user'] : '';
        $basic_password = isset($endpoint['basic_password']) ? $endpoint['basic_password'] : '';
        
        $response = wp_remote_get($endpoint_url, [
            'timeout' => 30,
            'headers' => [
                'Authorization' => $auth_type === 'token' ? 'Bearer ' . $token : '',
                'User-Agent' => 'WordPress/Bricks-API-Integrator'
            ]
        ]);
        
        if (is_wp_error($response)) {
            error_log('Error en petición API: ' . $response->get_error_message());
            return $results;
        }
        
        $status_code = wp_remote_retrieve_response_code($response);
        error_log('Código HTTP: ' . $status_code);
        
        if ($status_code !== 200) {
            error_log('HTTP Error: ' . $status_code);
            $error_body = wp_remote_retrieve_body($response);
            error_log('Error body: ' . substr($error_body, 0, 200));
            return $results;
        }
        
        $body = wp_remote_retrieve_body($response);
        $api_data = json_decode($body, true);
        
        if (json_last_error() !== JSON_ERROR_NONE) {
            error_log('Error JSON: ' . json_last_error_msg());
            error_log('Body: ' . substr($body, 0, 300));
            return $results;
        }
        
        if (empty($api_data) || !is_array($api_data)) {
            error_log('Datos vacíos o no es array');
            return $results;
        }
        
        error_log('Datos obtenidos exitosamente');
        error_log('Cantidad de elementos: ' . count($api_data));
        
        // Aplicar paginación si es necesario
        $page = isset($query_obj->query_args['page']) ? intval($query_obj->query_args['page']) : 1;
        $items_per_page = isset($query_obj->query_args['posts_per_page']) ? intval($query_obj->query_args['posts_per_page']) : 10;
        
        $total_items = count($api_data);
        $total_pages = ceil($total_items / $items_per_page);
        
        // Paginar los resultados
        if ($total_items > $items_per_page) {
            $offset = ($page - 1) * $items_per_page;
            $api_data = array_slice($api_data, $offset, $items_per_page);
        }
        
        // Devolver los resultados en el formato esperado por Bricks
        return [
            'count' => $total_items,
            'items' => $api_data,
            'max_num_pages' => $total_pages,
        ];
        
    } catch (Exception $e) {
        error_log('EXCEPCIÓN en query: ' . $e->getMessage());
        error_log('Stack trace: ' . $e->getTraceAsString());
        return $results;
    }
add_filter('bricks/dynamic_data/render_content', function($content, $post, $context) {
    // Solo procesar si contiene nuestros tags
    if (strpos($content, '{api_') === false) {
        return $content;
    }
    
    error_log('=== RENDERIZANDO CONTENIDO API ===');
    error_log('Contenido original: ' . $content);
    error_log('Contexto: ' . $context);
    
    // Obtener el objeto de loop actual si estamos en un loop
    global $bricks_loop_query;
    
    if (isset($bricks_loop_query) && is_object($bricks_loop_query) && $bricks_loop_query->is_looping) {
        $loop_object = $bricks_loop_query->current_item;
        error_log('Loop object disponible: ' . (is_array($loop_object) ? json_encode($loop_object) : 'No es array'));
        
        // Procesar tags en el formato {api_field}
        preg_match_all('/{api_(.*?)}/', $content, $matches);
        
        if (!empty($matches[0])) {
            foreach ($matches[0] as $index => $tag) {
                $field = $matches[1][$index];
                $value = '';
                
                // Buscar el campo en el objeto de loop
                if (isset($loop_object[$field])) {
                    $value = $loop_object[$field];
                    error_log('Campo encontrado en loop: ' . $field . ' = ' . (is_array($value) ? json_encode($value) : $value));
                    
                    // Convertir arrays a string si es necesario
                    if (is_array($value)) {
                        $value = implode(', ', $value);
                    }
                    
                    // Reemplazar el tag con el valor
                    $content = str_replace($tag, $value, $content);
                } else {
                    // Intentar buscar en campos anidados usando notación de puntos
                    $nested_keys = explode('_', $field);
                    $nested_value = $loop_object;
                    $found = true;
                    
                    foreach ($nested_keys as $key) {
                        if (isset($nested_value[$key])) {
                            $nested_value = $nested_value[$key];
                        } else {
                            $found = false;
                            break;
                        }
                    }
                    
                    if ($found) {
                        error_log('Campo anidado encontrado: ' . $field . ' = ' . (is_array($nested_value) ? json_encode($nested_value) : $nested_value));
                        
                        // Convertir arrays a string si es necesario
                        if (is_array($nested_value)) {
                            $nested_value = implode(', ', $nested_value);
                        }
                        
                        // Reemplazar el tag con el valor
                        $content = str_replace($tag, $nested_value, $content);
                    }
                }
                
                error_log('Valor obtenido para ' . $tag . ': ' . $value);
            }
        }
    } else {
        error_log('No hay loop object disponible');
    }
    
    return $content;
}, 30, 3);
add_action('init', 'bricks_api_integrator_register_query_loop_sources', 30);

// Asegurarse de que la función get_api_data esté disponible
if (!function_exists('get_api_data')) {
    /**
     * Get API data from endpoint with authentication support
     *
     * @param string $endpoint_url The URL of the API endpoint
     * @param array $endpoint_config Optional endpoint configuration with authentication details
     * @return array|null The API data or null on error
     */
    function get_api_data($endpoint_url, $endpoint_config = [])
    {
        // Prepare request arguments
        $args = [];
        
        // Add authentication if provided in endpoint config
        if (!empty($endpoint_config)) {
            $auth_type = isset($endpoint_config['auth_type']) ? $endpoint_config['auth_type'] : 'none';
            
            if ($auth_type === 'token') {
                $token = isset($endpoint_config['token']) ? $endpoint_config['token'] : '';
                if (!empty($token)) {
                    $args['headers'] = [
                        'Authorization' => 'Bearer ' . $token,
                    ];
                }
            } elseif ($auth_type === 'basic') {
                $user = isset($endpoint_config['basic_user']) ? $endpoint_config['basic_user'] : '';
                $password = isset($endpoint_config['basic_password']) ? $endpoint_config['basic_password'] : '';
                if (!empty($user) && !empty($password)) {
                    $args['headers'] = [
                        'Authorization' => 'Basic ' . base64_encode("$user:$password"),
                    ];
                }
            }
        }
        
        // Make the API request
        $response = wp_remote_get($endpoint_url, $args);

        if (is_wp_error($response)) {
            return null; // Return null on error
        }

        $body = wp_remote_retrieve_body($response);
        $data = json_decode($body, true);

        if (empty($data)) {
            return null; // Return null if data is empty or invalid
        }

        return $data;
    }
}

// Register dynamic tags for Bricks Query Loop
function bricks_api_register_dynamic_tags_for_query_loop($tags) {
    // Get API sources
    $api_sources = get_option('bricks_api_sources', []);
    
    if (empty($api_sources)) {
        return $tags;
    }
    
    // Add tags for each source
    foreach ($api_sources as $source_id => $source) {
        $source_name = isset($source['name']) ? $source['name'] : esc_html__('Unnamed Source', 'bricks-api-integrator');
        
        // Get fields from source
        $fields = isset($source['fields']) ? $source['fields'] : [];
        
        if (empty($fields)) {
            // Try to get fields from sample data
            $sample_data = isset($source['sample_data']) ? $source['sample_data'] : '';
            
            if (!empty($sample_data)) {
                $sample_data = json_decode($sample_data, true);
                
                if (is_array($sample_data) && !empty($sample_data)) {
                    // Get first item if it's an array of items
                    $first_item = is_array(reset($sample_data)) ? reset($sample_data) : $sample_data;
                    
                    if (is_array($first_item)) {
                        $fields = array_keys($first_item);
                    }
                }
            }
        }
        
        // Add tags for each field
        if (!empty($fields)) {
            foreach ($fields as $field) {
                $field_key = is_array($field) ? $field['key'] : $field;
                $field_name = is_array($field) ? $field['name'] : $field;
                
                $tag_key = $source_id . '_' . $field_key;
                $tag_name = $source_name . ': ' . $field_name;
                
                $tags[$tag_key] = [
                    'name' => $tag_name,
                    'label' => $tag_name,
                    'group' => 'API Sources',
                    'source' => $source_id,
                ];
            }
        }
    }
    
    return $tags;
}
add_filter('bricks/query/dynamic_tags', 'bricks_api_register_dynamic_tags_for_query_loop');

