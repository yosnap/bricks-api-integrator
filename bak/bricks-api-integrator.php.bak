// Callback del dashboard
function bricks_api_integrator_dashboard() {
    // Verificar permisos
    if (!current_user_can('manage_options')) {
        return;
    }
    
    // Obtener endpoints configurados
    $endpoints = get_option('bricks_api_endpoints', []);
    $api_sources = get_option('bricks_api_sources', []);
    
    // Contar endpoints y sources
    $endpoints_count = count($endpoints);
    $sources_count = count($api_sources);
    
    // Verificar si hay un endpoint seleccionado para probar
    $test_endpoint_id = isset($_GET['test_endpoint']) ? sanitize_text_field($_GET['test_endpoint']) : '';
    $test_result = null;
    
    if (!empty($test_endpoint_id) && isset($endpoints[$test_endpoint_id])) {
        $endpoint = $endpoints[$test_endpoint_id];
        $endpoint_url = isset($endpoint['url']) ? $endpoint['url'] : '';
        
        if (!empty($endpoint_url)) {
            $test_result = get_api_data($endpoint_url, $endpoint);
        }
    }
    
    // Renderizar la página
    ?>
    <div class="wrap">
        <h1><?php echo esc_html__('Bricks API Integrator', 'bricks-api-integrator'); ?></h1>
        
        <div class="notice notice-info">
            <p><?php echo esc_html__('Welcome to Bricks API Integrator! This plugin allows you to connect Bricks Builder with external APIs.', 'bricks-api-integrator'); ?></p>
        </div>
        
        <div class="card">
            <h2><?php echo esc_html__('Overview', 'bricks-api-integrator'); ?></h2>
            <p><?php echo esc_html__('Current configuration:', 'bricks-api-integrator'); ?></p>
            <ul>
                <li><?php echo sprintf(esc_html__('API Endpoints: %d', 'bricks-api-integrator'), $endpoints_count); ?></li>
                <li><?php echo sprintf(esc_html__('API Sources: %d', 'bricks-api-integrator'), $sources_count); ?></li>
            </ul>
        </div>
        
        <?php if (!empty($endpoints)) : ?>
        <div class="card">
            <h2><?php echo esc_html__('Test API Endpoint', 'bricks-api-integrator'); ?></h2>
            <form method="get">
                <input type="hidden" name="page" value="bricks-api-integrator">
                <select name="test_endpoint">
                    <option value=""><?php echo esc_html__('Select an endpoint', 'bricks-api-integrator'); ?></option>
                    <?php foreach ($endpoints as $id => $endpoint) : ?>
                        <option value="<?php echo esc_attr($id); ?>" <?php selected($test_endpoint_id, $id); ?>>
                            <?php echo esc_html($endpoint['name']); ?>
                        </option>
                    <?php endforeach; ?>
                </select>
                <button type="submit" class="button button-primary"><?php echo esc_html__('Test', 'bricks-api-integrator'); ?></button>
            </form>
            
            <?php if ($test_result !== null) : ?>
                <div class="api-test-result">
                    <h3><?php echo esc_html__('API Response:', 'bricks-api-integrator'); ?></h3>
                    <div class="api-response-data">
                        <?php render_api_item_table($test_result); ?>
                    </div>
                </div>
            <?php endif; ?>
        </div>
        <?php endif; ?>
        
        <div class="card">
            <h2><?php echo esc_html__('Getting Started', 'bricks-api-integrator'); ?></h2>
            <ol>
                <li><?php echo esc_html__('Configure your API endpoints in the API Endpoints section.', 'bricks-api-integrator'); ?></li>
                <li><?php echo esc_html__('Create API sources in the API Sources section.', 'bricks-api-integrator'); ?></li>
                <li><?php echo esc_html__('Use the API Launcher to create dynamic tags for your API data.', 'bricks-api-integrator'); ?></li>
                <li><?php echo esc_html__('Configure templates for your API data in the API Templates section.', 'bricks-api-integrator'); ?></li>
                <li><?php echo esc_html__('Use the API sources in Bricks Query Loop to display your API data.', 'bricks-api-integrator'); ?></li>
            </ol>
        </div>
    </div>
    <?php
}

// Función para renderizar los datos de un objeto o array
function render_api_item_table($item, $parent_key = '$payload') {
    if (is_array($item)) {
        // Check if it's a simple array of strings/numbers
        if (all_items_are_strings_or_numbers($item)) {
            echo '<ul class="api-item-list">';
            foreach ($item as $value) {
                echo '<li>' . esc_html($value) . '</li>';
            }
            echo '</ul>';
            return;
        }
        
        echo '<table class="widefat api-item-table">';
        echo '<thead><tr><th>Key</th><th>Value</th><th>Type</th></tr></thead>';
        echo '<tbody>';
        
        foreach ($item as $key => $value) {
            $type = gettype($value);
            $display_key = $parent_key . '.' . $key;
            
            echo '<tr>';
            echo '<td>' . esc_html($key) . '</td>';
            
            if (is_array($value) || is_object($value)) {
                echo '<td class="api-nested-value">';
                render_api_item_table($value, $display_key);
                echo '</td>';
            } else {
                echo '<td>' . esc_html(is_bool($value) ? ($value ? 'true' : 'false') : $value) . '</td>';
            }
            
            echo '<td>' . esc_html($type) . '</td>';
            echo '</tr>';
        }
        
        echo '</tbody></table>';
    } elseif (is_object($item)) {
        render_api_item_table(get_object_vars($item), $parent_key);
    } else {
        echo esc_html($item);
    }
}

// Helper function to check if all array items are strings or numbers
function all_items_are_strings_or_numbers($array) {
    if (!is_array($array) || empty($array)) {
        return false;
    }
    
    foreach ($array as $item) {
        if (!is_string($item) && !is_numeric($item)) {
            return false;
        }
    }
    
    return true;
}

// Registro de la configuración del endpoint
add_action('admin_init', 'bricks_api_integrator_settings_init');

function bricks_api_integrator_settings_init() {
    register_setting('bricks_api_integrator', 'bricks_api_endpoints');
    
    add_settings_section(
        'bricks_api_integrator_endpoints_section',
        esc_html__('API Endpoints', 'bricks-api-integrator'),
        'bricks_api_endpoints_section_callback',
        'bricks-api-integrator'
    );
    
    add_settings_field(
        'bricks_api_endpoints',
        esc_html__('Endpoints', 'bricks-api-integrator'),
        'bricks_api_endpoints_render',
        'bricks-api-integrator',
        'bricks_api_integrator_endpoints_section'
    );
}

// Campo para agregar múltiples endpoints
function bricks_api_endpoints_render() {
    $endpoints = get_option('bricks_api_endpoints', []);
    ?>
    <div id="api-endpoints-container">
        <?php if (empty($endpoints)) : ?>
            <div class="api-endpoint">
                <p>
                    <label><?php echo esc_html__('Endpoint Name', 'bricks-api-integrator'); ?></label>
                    <input type="text" name="bricks_api_endpoints[endpoint_0][name]" value="" />
                </p>
                <p>
                    <label><?php echo esc_html__('Endpoint URL', 'bricks-api-integrator'); ?></label>
                    <input type="url" name="bricks_api_endpoints[endpoint_0][url]" value="" class="regular-text" />
                </p>
                <p>
                    <label><?php echo esc_html__('Authentication Type', 'bricks-api-integrator'); ?></label>
                    <select name="bricks_api_endpoints[endpoint_0][auth_type]">
                        <option value="none"><?php echo esc_html__('None', 'bricks-api-integrator'); ?></option>
                        <option value="token"><?php echo esc_html__('Bearer Token', 'bricks-api-integrator'); ?></option>
                        <option value="basic"><?php echo esc_html__('Basic Auth', 'bricks-api-integrator'); ?></option>
                    </select>
                </p>
                <div class="auth-fields auth-token" style="display: none;">
                    <p>
                        <label><?php echo esc_html__('Token', 'bricks-api-integrator'); ?></label>
                        <input type="text" name="bricks_api_endpoints[endpoint_0][token]" value="" class="regular-text" />
                    </p>
                </div>
                <div class="auth-fields auth-basic" style="display: none;">
                    <p>
                        <label><?php echo esc_html__('Username', 'bricks-api-integrator'); ?></label>
                        <input type="text" name="bricks_api_endpoints[endpoint_0][basic_user]" value="" />
                    </p>
                    <p>
                        <label><?php echo esc_html__('Password', 'bricks-api-integrator'); ?></label>
                        <input type="password" name="bricks_api_endpoints[endpoint_0][basic_password]" value="" />
                    </p>
                </div>
            </div>
        <?php else : ?>
            <?php foreach ($endpoints as $id => $endpoint) : ?>
                <div class="api-endpoint">
                    <p>
                        <label><?php echo esc_html__('Endpoint Name', 'bricks-api-integrator'); ?></label>
                        <input type="text" name="bricks_api_endpoints[<?php echo esc_attr($id); ?>][name]" value="<?php echo esc_attr($endpoint['name']); ?>" />
                    </p>
                    <p>
                        <label><?php echo esc_html__('Endpoint URL', 'bricks-api-integrator'); ?></label>
                        <input type="url" name="bricks_api_endpoints[<?php echo esc_attr($id); ?>][url]" value="<?php echo esc_attr($endpoint['url']); ?>" class="regular-text" />
                    </p>
                    <p>
                        <label><?php echo esc_html__('Authentication Type', 'bricks-api-integrator'); ?></label>
                        <select name="bricks_api_endpoints[<?php echo esc_attr($id); ?>][auth_type]" class="auth-type-select">
                            <option value="none" <?php selected($endpoint['auth_type'] ?? 'none', 'none'); ?>><?php echo esc_html__('None', 'bricks-api-integrator'); ?></option>
                            <option value="token" <?php selected($endpoint['auth_type'] ?? 'none', 'token'); ?>><?php echo esc_html__('Bearer Token', 'bricks-api-integrator'); ?></option>
                            <option value="basic" <?php selected($endpoint['auth_type'] ?? 'none', 'basic'); ?>><?php echo esc_html__('Basic Auth', 'bricks-api-integrator'); ?></option>
                        </select>
                    </p>
                    <div class="auth-fields auth-token" style="display: <?php echo ($endpoint['auth_type'] ?? 'none') === 'token' ? 'block' : 'none'; ?>;">
                        <p>
                            <label><?php echo esc_html__('Token', 'bricks-api-integrator'); ?></label>
                            <input type="text" name="bricks_api_endpoints[<?php echo esc_attr($id); ?>][token]" value="<?php echo esc_attr($endpoint['token'] ?? ''); ?>" class="regular-text" />
                        </p>
                    </div>
                    <div class="auth-fields auth-basic" style="display: <?php echo ($endpoint['auth_type'] ?? 'none') === 'basic' ? 'block' : 'none'; ?>;">
                        <p>
                            <label><?php echo esc_html__('Username', 'bricks-api-integrator'); ?></label>
                            <input type="text" name="bricks_api_endpoints[<?php echo esc_attr($id); ?>][basic_user]" value="<?php echo esc_attr($endpoint['basic_user'] ?? ''); ?>" />
                        </p>
                        <p>
                            <label><?php echo esc_html__('Password', 'bricks-api-integrator'); ?></label>
                            <input type="password" name="bricks_api_endpoints[<?php echo esc_attr($id); ?>][basic_password]" value="<?php echo esc_attr($endpoint['basic_password'] ?? ''); ?>" />
                        </p>
                    </div>
                    <p><button type="button" class="button remove-endpoint"><?php echo esc_html__('Remove', 'bricks-api-integrator'); ?></button></p>
                </div>
            <?php endforeach; ?>
        <?php endif; ?>
    </div>
    <p><button type="button" class="button" id="add-endpoint"><?php echo esc_html__('Add Endpoint', 'bricks-api-integrator'); ?></button></p>
    <?php
}

// Enqueue styles and scripts
add_action('admin_enqueue_scripts', 'bricks_api_integrator_assets');

function bricks_api_integrator_assets() {
    wp_enqueue_style('bricks-api-integrator-admin', BRICKS_API_INTEGRATOR_URL . 'assets/css/admin.css', [], BRICKS_API_INTEGRATOR_VERSION);
    wp_enqueue_script('bricks-api-integrator-admin', BRICKS_API_INTEGRATOR_URL . 'assets/js/admin.js', ['jquery'], BRICKS_API_INTEGRATOR_VERSION, true);
}
